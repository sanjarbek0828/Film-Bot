{
  "name": "kino-bot",
  "version": "2.0.0",
  "description": "FilmXBot - O'zbek tilidagi to'liq funksiyali Telegram kino boti + WebApp katalogi",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "build:webapp": "npm --prefix webapp install && npm --prefix webapp run build",
    "build": "npm run build:webapp"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "telegram",
    "bot",
    "kino",
    "movie",
    "telegraf",
    "webapp"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "1.7.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "mongoose": "9.1.2",
    "node-cache": "5.1.2",
    "telegraf": "4.16.3"
  }
}

# ═══════════════════════════════════════════════════════
# FilmXBot konfiguratsiyasi
# Bu faylni `.env` nomi bilan nusxalang va qiymatlarni to'ldiring.
# ═══════════════════════════════════════════════════════

# @BotFather dan olingan bot tokeni (MAJBURIY)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# MongoDB ulanish manzili (MAJBURIY)
# Masalan: mongodb://localhost:27017/kinobot
# yoki Atlas: mongodb+srv://user:pass@cluster.mongodb.net/kinobot
MONGODB_URI=mongodb://localhost:27017/kinobot

# Admin Telegram ID lari — vergul bilan ajrating (MAJBURIY)
# @userinfobot dan oling. Masalan: 123456789,987654321
ADMIN_ID=123456789

# ═══════════ Ixtiyoriy ═══════════

# Server porti (default: 3000)
PORT=3000

# Ommaviy HTTPS manzil (webhook + WebApp uchun).
# Render.com bu qiymatni RENDER_EXTERNAL_URL sifatida avtomatik beradi.
# Bo'sh qoldirilsa — bot Long Polling rejimida ishlaydi (mahalliy test uchun).
PUBLIC_URL=

# Qo'llab-quvvatlash uchun admin username (@ belgisiz)
SUPPORT_USERNAME=sanjarbek_404

# Avto-post uchun standart kanal ID (bot admin bo'lishi kerak)
CHANNEL_ID=

# Log darajasi: error | warn | info | debug
LOG_LEVEL=info

# VIP narxlari (Telegram Stars)
VIP_STARS_30=50
VIP_STARS_365=300

NODE_ENV=production
